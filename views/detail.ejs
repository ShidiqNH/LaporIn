<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Detail Aduan - LaporIn</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        :root { --primary: #2563eb; --bg: #f1f5f9; }
        body { background: var(--bg); font-family: 'Inter', sans-serif; }
        .navbar { background: white; border-bottom: 1px solid #e2e8f0; }
        .detail-card { border: none; border-radius: 25px; overflow: hidden; background: white; }
        .img-main { width: 100%; max-height: 450px; object-fit: cover; }
        
        .verification-panel { 
            background: #eff6ff; 
            border: 2px dashed #2563eb; 
            border-radius: 20px; 
            padding: 2rem;
        }
        .evidence-img { width: 100%; border-radius: 15px; box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1); margin-top: 15px; }
        
        .btn-maps { transition: 0.3s; font-weight: 600; color: var(--primary); border-color: var(--primary); }
        .btn-maps:hover { background-color: var(--primary); color: white; }
        
        .btn-delete { transition: 0.3s; color: #dc3545; border-color: #dc3545; }
        .btn-delete:hover { background-color: #dc3545; color: white; }
        
        .badge-status { font-size: 0.75rem; padding: 6px 16px; border-radius: 50px; font-weight: 700; }
    </style>
</head>
<body>

<nav class="navbar sticky-top mb-4">
    <div class="container">
        <a class="navbar-brand fw-bold text-primary" href="/reports">
            <i class="bi bi-arrow-left me-2"></i>Peta Lokasi
        </a>
        <div class="d-flex align-items-center">
            <% if (locals.admin) { %>
                <span class="badge bg-primary me-3">Mode Admin</span>
                <a href="/logout" class="btn btn-outline-danger btn-sm rounded-pill px-3">Logout</a>
            <% } else { %>
                <a href="/dashboard" class="btn btn-outline-secondary btn-sm rounded-pill px-3 me-2">Ke Beranda</a>
                <a href="/login" class="btn btn-primary btn-sm rounded-pill px-3">Login Admin</a>
            <% } %>
        </div>
    </div>
</nav>

<div class="container mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card detail-card shadow-sm">
                <img src="<%= report.image_url %>" class="img-main" alt="Foto Fasilitas">
                
                <div class="card-body p-4 p-md-5">
                    <div class="d-flex flex-wrap justify-content-between align-items-start mb-3">
                        <div class="flex-grow-1 me-3">
                            <% 
                                let badgeClass = 'bg-warning text-dark';
                                if(report.status === 'Selesai') badgeClass = 'bg-success text-white';
                            %>
                            <span class="badge badge-status <%= badgeClass %> text-uppercase mb-2">
                                <%= report.status === 'Selesai' ? 'Sudah Diperbaiki' : 'Menunggu Perbaikan' %>
                            </span>
                            <h2 class="fw-bold mb-1"><%= report.title %></h2>
                            <p class="text-muted mb-3">
                                <i class="bi bi-geo-alt-fill text-danger me-1"></i> <%= report.location_name %>
                            </p>
                            
                            <div class="mb-4">
                                <a href="https://www.google.com/maps/search/?api=1&query=<%= report.latitude %>,<%= report.longitude %>" 
                                   target="_blank" 
                                   class="btn btn-outline-primary btn-sm btn-maps rounded-pill px-3 shadow-sm">
                                    <i class="bi bi-cursor-fill me-2"></i>Navigasi ke Lokasi
                                </a>
                            </div>
                        </div>
                        
                        <div class="text-md-end mb-3">
                            <small class="text-secondary d-block">Tanggal Lapor:</small>
                            <span class="fw-bold d-block mb-3 text-dark">
                                <%= new Date(report.created_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) %>
                            </span>
                            
                            <% if (locals.admin) { %>
                                <form action="/reports/<%= report.id %>/delete" method="POST" onsubmit="return confirm('Hapus permanen laporan ini?');">
                                    <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3 btn-delete">
                                        <i class="bi bi-trash3 me-1"></i> Hapus Laporan
                                    </button>
                                </form>
                            <% } %>
                        </div>
                    </div>

                    <div class="mb-4">
                        <h6 class="fw-bold text-uppercase small text-secondary">Deskripsi Aduan:</h6>
                        <p class="lead" style="font-size: 1.05rem; color: #334155;"><%= report.description || 'Tidak ada deskripsi tambahan.' %></p>
                    </div>

                    <hr class="my-5" style="opacity: 0.1;">

                    <% if (report.status !== 'Selesai') { %>
                        
                        <% if (locals.admin) { %>
                            <div class="verification-panel">
                                <div class="text-center mb-4">
                                    <i class="bi bi-tools text-primary display-4"></i>
                                    <h4 class="fw-bold mt-2">Update Perbaikan</h4>
                                    <p class="text-muted">Halo Admin, silakan upload foto hasil perbaikan untuk menyelesaikan laporan ini.</p>
                                </div>
                                
                                <form action="/reports/<%= report.id %>/verify" method="POST" enctype="multipart/form-data">
                                    <div class="mb-4">
                                        <label class="form-label fw-bold">Foto Bukti Perbaikan</label>
                                        <input type="file" name="evidence" class="form-control form-control-lg border-primary shadow-sm" accept="image/*" capture="environment" required>
                                        <div class="form-text mt-2 text-primary small">
                                            <i class="bi bi-info-circle me-1"></i> Ambil foto fasilitas yang sudah berfungsi kembali secara real-time.
                                        </div>
                                    </div>
                                    <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold shadow">
                                        Konfirmasi Perbaikan Selesai
                                    </button>
                                </form>
                            </div>
                        <% } else { %>
                            <div class="alert alert-light border text-center rounded-4 p-4">
                                <i class="bi bi-hourglass-split text-warning fs-3 d-block mb-2"></i>
                                <h6 class="fw-bold text-dark">Menunggu Tindakan Petugas</h6>
                                <p class="text-muted small mb-0">Laporan ini telah diterima dan sedang menunggu antrean perbaikan oleh tim teknis terkait.</p>
                            </div>
                        <% } %>

                    <% } else { %>
                        <div class="alert bg-white border-primary rounded-4 p-4 shadow-sm">
                            <div class="d-flex align-items-center mb-3">
                                <i class="bi bi-check-circle-fill text-success fs-2 me-3"></i>
                                <div>
                                    <h5 class="fw-bold mb-0 text-dark">Laporan Selesai Ditangani</h5>
                                    <small class="text-success fw-bold">Status: Terverifikasi</small>
                                </div>
                            </div>
                            <p class="text-muted small">Fasilitas ini telah diperbaiki oleh tim teknis dan sudah berfungsi kembali dengan normal.</p>
                            
                            <% if(report.evidence_url) { %>
                                <div class="mt-4 pt-3 border-top">
                                    <p class="small fw-bold text-uppercase text-secondary mb-2">Foto Hasil Perbaikan:</p>
                                    <img src="<%= report.evidence_url %>" class="evidence-img" alt="Bukti Perbaikan">
                                </div>
                            <% } %>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>