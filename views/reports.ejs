<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LaporIn - Peta Sebaran Fasilitas</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    
    <style>
        :root { --primary: #2563eb; --bg: #f1f5f9; }
        body { background: var(--bg); font-family: 'Inter', sans-serif; }
        
        .navbar { background: white; border-bottom: 1px solid #e2e8f0; }
        
        #map { 
            height: 550px; 
            width: 100%; 
            border-radius: 25px; 
            box-shadow: 0 10px 25px rgba(0,0,0,0.05);
            z-index: 1;
        }

        .report-side-card {
            background: white;
            border-radius: 20px;
            border: none;
            max-height: 550px;
            overflow-y: auto;
        }

        .list-group-item {
            border: 1px solid #f1f5f9;
            border-left: 4px solid transparent;
            margin-bottom: 10px;
            transition: 0.3s;
            border-radius: 12px !important;
            cursor: pointer;
        }

        .list-group-item:hover {
            background: #eff6ff;
            border-left: 4px solid var(--primary);
            transform: scale(1.02);
        }

        .status-dot {
            height: 12px;
            width: 12px;
            border-radius: 50%;
            display: inline-block;
            margin-right: 5px;
        }

        /* Leaflet Popup Styling */
        .leaflet-popup-content-wrapper {
            border-radius: 15px;
            padding: 5px;
        }
        .popup-img {
            width: 100%;
            height: 110px;
            object-fit: cover;
            border-radius: 10px;
            margin-bottom: 10px;
        }
        .btn-detail-popup {
            background-color: var(--primary);
            color: white;
            font-size: 11px;
            border-radius: 8px;
            width: 100%;
            text-decoration: none;
            display: block;
            text-align: center;
            padding: 8px 0;
            font-weight: 600;
        }
        
        /* Custom Scrollbar */
        .report-side-card::-webkit-scrollbar { width: 6px; }
        .report-side-card::-webkit-scrollbar-track { background: #f1f5f9; }
        .report-side-card::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
    </style>
</head>
<body>

<nav class="navbar sticky-top">
    <div class="container">
        <a class="navbar-brand fw-bold text-primary" href="/dashboard">
            <i class="bi bi-arrow-left-circle-fill me-2"></i>Kembali
        </a>
        <span class="fw-bold text-secondary text-uppercase small ls-1">Peta Pemantauan Fasilitas</span>
    </div>
</nav>

<div class="container my-5">
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="fw-bold m-0 text-dark">Sebaran Kerusakan</h4>
                <div class="badge bg-primary px-3 py-2 rounded-pill shadow-sm">
                    <i class="bi bi-geo-alt-fill me-1"></i> Mode Pemantauan Real-time
                </div>
            </div>
            <div id="map"></div>
        </div>

        <div class="col-lg-4">
            <h4 class="fw-bold mb-3">Titik Laporan</h4>
            <div class="card report-side-card shadow-sm p-3">
                <div class="list-group list-group-flush">
                    <% if (locals.reports && reports.length > 0) { %>
                        <% reports.forEach(r => { %>
                            <div class="list-group-item p-3 shadow-sm" onclick="focusMarker('<%= r.latitude %>', '<%= r.longitude %>')">
                                <div class="d-flex justify-content-between align-items-start">
                                    <h6 class="fw-bold mb-1 text-dark"><%= r.title %></h6>
                                    <% 
                                        let dotColor = '#f59e0b'; // Pending
                                        if(r.status === 'Selesai') dotColor = '#10b981'; // Selesai
                                    %>
                                    <span class="status-dot" style="background-color: <%= dotColor %>;" title="<%= r.status %>"></span>
                                </div>
                                <p class="text-muted small mb-2 text-truncate">
                                    <i class="bi bi-geo-alt me-1"></i><%= r.location_name %>
                                </p>
                                <div class="d-flex justify-content-between align-items-center mt-2">
                                    <small class="text-secondary" style="font-size: 0.75rem;">
                                        <%= new Date(r.created_at).toLocaleDateString('id-ID') %>
                                    </small>
                                    <a href="/reports/<%= r.id %>" class="btn btn-sm btn-link text-primary p-0 fw-bold text-decoration-none">Detail <i class="bi bi-chevron-right"></i></a>
                                </div>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <div class="text-center py-5">
                            <i class="bi bi-map text-light display-1"></i>
                            <p class="text-muted mt-3">Tidak ada titik koordinat ditemukan.</p>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script>
    // 1. Inisialisasi Peta
    const map = L.map('map').setView([-2.5489, 118.0149], 5);

    // 2. Tile Layer (OpenStreetMap)
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>'
    }).addTo(map);

    // 3. Parsing Data dari Server (Aman dengan fallback array kosong)
    const reports = <%- JSON.stringify(locals.reports || []) %>;
    const markers = {};

    // 4. Looping untuk membuat Marker
    reports.forEach(r => {
        if (r.latitude && r.longitude) {
            const lat = parseFloat(r.latitude);
            const lng = parseFloat(r.longitude);

            const marker = L.marker([lat, lng]).addTo(map);
            
            markers[`${lat},${lng}`] = marker;

            // Template Popup
            const popupContent = `
                <div style="width: 180px; font-family: 'Inter', sans-serif;">
                    <img src="${r.image_url}" class="popup-img" alt="${r.title}">
                    <h6 style="margin: 0 0 5px 0; font-weight: bold; color: #1e293b;">${r.title}</h6>
                    <div style="display: flex; align-items: center; margin-bottom: 10px;">
                        <span style="height: 8px; width: 8px; border-radius: 50%; background: ${r.status === 'Selesai' ? '#10b981' : '#f59e0b'}; display: inline-block; margin-right: 5px;"></span>
                        <span style="font-size: 11px; color: #64748b;">${r.status}</span>
                    </div>
                    <a href="/reports/${r.id}" class="btn-detail-popup">Buka Detail</a>
                </div>
            `;
            marker.bindPopup(popupContent);
        }
    });

    // 5. Fungsi Klik List untuk Arahkan Peta
    function focusMarker(lat, lng) {
        const latitude = parseFloat(lat);
        const longitude = parseFloat(lng);
        
        map.setView([latitude, longitude], 17, {
            animate: true,
            pan: { duration: 1 }
        });

        if(markers[`${lat},${lng}`]) {
            markers[`${lat},${lng}`].openPopup();
        }
    }

    // 6. Autofocus ke Laporan Terbaru jika ada data
    if (reports.length > 0 && reports[0].latitude) {
        map.setView([parseFloat(reports[0].latitude), parseFloat(reports[0].longitude)], 13);
    }
</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>